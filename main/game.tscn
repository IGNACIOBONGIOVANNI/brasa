[node name="Game" type="Node2D"]
script = ExtResource("1_game")

[node name="WorldView" type="SubViewportContainer" parent="."]
offset_right = 320.0
offset_bottom = 180.0
stretch = true

[node name="World" type="SubViewport" parent="WorldView"]
handle_input_locally = false
size = Vector2i(320, 180)
render_target_update_mode = 4

[node name="Ambient" type="CanvasModulate" parent="WorldView/World"]
color = Color(0.55, 0.5, 0.62, 1)

[node name="Rooms" type="Node2D" parent="WorldView/World"]

[node name="Decals" type="Node2D" parent="WorldView/World" groups=["decals"]]

[node name="Entities" type="Node2D" parent="WorldView/World" groups=["entities"]]
z_index = 1
y_sort_enabled = true

[node name="Player" parent="WorldView/World/Entities" instance=ExtResource("2_player")]

[node name="Projectiles" type="Node2D" parent="WorldView/World" groups=["projectiles"]]
z_index = 1

[node name="Effects" type="Node2D" parent="WorldView/World" groups=["effects"]]
z_index = 1

[node name="GameCamera" type="Camera2D" parent="WorldView/World"]
script = ExtResource("6_camera")

[node name="Motes" type="CPUParticles2D" parent="WorldView/World/GameCamera"]
material = ExtResource("12_unshaded")
z_index = 2
emitting = false
script = ExtResource("11_motes")

[node name="FloorController" type="Node" parent="." node_paths=PackedStringArray("rooms_root", "entities", "player", "camera", "fade")]
script = ExtResource("3_floor")
run = ExtResource("4_run")
rooms_root = NodePath("../WorldView/World/Rooms")
entities = NodePath("../WorldView/World/Entities")
player = NodePath("../WorldView/World/Entities/Player")
camera = NodePath("../WorldView/World/GameCamera")
fade = NodePath("../ScreenFade")

[node name="HitStop" type="Node" parent="."]
script = ExtResource("5_hit_stop")

[node name="Hud" parent="." instance=ExtResource("7_hud")]

[node name="ScreenFade" parent="." instance=ExtResource("8_fade")]

[node name="PauseMenu" parent="." instance=ExtResource("9_pause")]

[node name="Inventory" type="CanvasLayer" parent="."]
