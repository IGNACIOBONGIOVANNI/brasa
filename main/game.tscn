[gd_scene format=3]

[ext_resource type="Script" path="res://main/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://entities/player/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://world/floor_controller.gd" id="3_floor"]
[ext_resource type="Resource" path="res://content/floors/floor_1.tres" id="4_floor_1"]
[ext_resource type="Script" path="res://fx/hit_stop.gd" id="5_hit_stop"]
[ext_resource type="Script" path="res://fx/game_camera.gd" id="6_camera"]
[ext_resource type="PackedScene" path="res://ui/hud/hud.tscn" id="7_hud"]

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

[node name="Rooms" type="Node2D" parent="."]

[node name="Decals" type="Node2D" parent="." groups=["decals"]]

[node name="Entities" type="Node2D" parent="." groups=["entities"]]
y_sort_enabled = true

[node name="Player" parent="Entities" instance=ExtResource("2_player")]

[node name="Projectiles" type="Node2D" parent="." groups=["projectiles"]]

[node name="Effects" type="Node2D" parent="." groups=["effects"]]

[node name="FloorController" type="Node" parent="." node_paths=PackedStringArray("rooms_root", "entities", "player", "camera")]
script = ExtResource("3_floor")
theme = ExtResource("4_floor_1")
rooms_root = NodePath("../Rooms")
entities = NodePath("../Entities")
player = NodePath("../Entities/Player")
camera = NodePath("../GameCamera")

[node name="HitStop" type="Node" parent="."]
script = ExtResource("5_hit_stop")

[node name="GameCamera" type="Camera2D" parent="."]
script = ExtResource("6_camera")

[node name="Hud" parent="." instance=ExtResource("7_hud")]
