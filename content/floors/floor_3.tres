[resource]
script = ExtResource("1_theme")
id = &"floor_3"
display_name = "Raíces"
room_count_min = 10
room_count_max = 12
min_boss_distance = 4
enemy_health_mult = 1.8
enemy_bullet_speed_mult = 1.2
difficulty_bonus = 1
floor_color = Color(0.169, 0.129, 0.09, 1)
floor_checker_color = Color(0.2, 0.153, 0.106, 1)
wall_color = Color(0.329, 0.251, 0.165, 1)
outline_color = Color(0.09, 0.063, 0.039, 1)
rock_color = Color(0.451, 0.376, 0.247, 1)
pit_color = Color(0.043, 0.031, 0.02, 1)
templates = Array[ExtResource("2_template_script")]([ExtResource("r0"), ExtResource("r1"), ExtResource("r2"), ExtResource("r3"), ExtResource("r4"), ExtResource("r5"), ExtResource("r6"), ExtResource("r7"), ExtResource("r8"), ExtResource("r9"), ExtResource("r10"), ExtResource("r11"), ExtResource("r12"), ExtResource("r13"), ExtResource("r14"), ExtResource("r15"), ExtResource("r16"), ExtResource("r17"), ExtResource("r18"), ExtResource("r19"), ExtResource("r20"), ExtResource("r21"), ExtResource("r22"), ExtResource("r23")])
enemies = Array[ExtResource("3_enemy_script")]([ExtResource("e_carnero"), ExtResource("e_vigia"), ExtResource("e_farol"), ExtResource("e_centinela"), ExtResource("e_espora"), ExtResource("e_raigon")])
pickups = Array[ExtResource("4_pickup_script")]([ExtResource("p_coin"), ExtResource("p_heart"), ExtResource("p_bomb"), ExtResource("p_key")])
