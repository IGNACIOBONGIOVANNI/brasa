mote_velocity = Vector2(3, 9)
mote_amount = 28
music = ExtResource("m_music")
boss_music = ExtResource("m_boss")
room_count_min = 6
room_count_max = 7
min_boss_distance = 3
enemy_health_mult = 1.6
enemy_bullet_speed_mult = 1.2
difficulty_bonus = 1
